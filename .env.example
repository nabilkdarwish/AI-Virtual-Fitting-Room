# Application Environment Configuration
# Copy this file to .env and adjust values for your local environment.

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
DEBUG_MODE=True
LOG_LEVEL=INFO

# Hardware & Video Capture Configuration
CAMERA_INDEX=0
CAMERA_FRAME_WIDTH=1280
CAMERA_FRAME_HEIGHT=720
CAMERA_TARGET_FPS=30

# Projector Display Configuration
PROJECTOR_DISPLAY_INDEX=1
PROJECTOR_RESOLUTION_WIDTH=1920
PROJECTOR_RESOLUTION_HEIGHT=1080
PROJECTOR_MIRROR_MODE=True

# AI Model Inference Settings
DEVICE=cuda
MODEL_PRECISION=fp16
INFERENCE_BATCH_SIZE=1
MAX_INFERENCE_TIMEOUT_SEC=5.0

# Paths
MODELS_DIR=./Models
DATASET_DIR=./Dataset
CATALOG_DIR=./Dataset/Catalog

# Voice Control
ENABLE_VOICE_CONTROL=True
VOICE_LANGUAGE=en-US
VOICE_ENERGY_THRESHOLD=300
